{
    "name": "ernestdefoe/nameplate",
    "description": "The member's panel beside every post, the way traditional forums show it: rank, post count, join date, best answers and likes received — plus signature options that work with FoF Signature.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "postbit",
        "profile",
        "signature"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/nameplate",
    "support": {
        "issues": "https://github.com/ernestdefoe/nameplate/issues",
        "source": "https://github.com/ernestdefoe/nameplate"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/likes": "Shows how many likes a member's posts have received.",
        "fof/best-answer": "Shows how many of a member's posts were chosen as the best answer.",
        "fof/signature": "Nameplate adds 'hide signatures' for members and 'once per page' for admins."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Nameplate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Nameplate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Nameplate",
            "category": "feature",
            "icon": {
                "name": "fas fa-id-badge",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/likes": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
